# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server components (storefront pages, page-view
# tracking) and bypasses RLS, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only)
STRIPE_SECRET_KEY=

# Optional: where Supabase sends the sign-up confirmation link in local
# development. Defaults to <current origin>/auth/callback.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Optional: uploads source maps to Sentry during `next build`.
SENTRY_AUTH_TOKEN=
